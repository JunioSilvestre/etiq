{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    }
  },
  "Paths": {
    "Processing": "F:\\Projetos\\Etiquetas\\TestOutput\\Processing",
    "Archive": "F:\\Projetos\\Etiquetas\\TestOutput\\Archive",
    "Failed": "F:\\Projetos\\Etiquetas\\TestOutput\\Failed",
    "Pdf": "F:\\Projetos\\Etiquetas\\TestOutput\\PDFs",
    "Temp": "F:\\Projetos\\Etiquetas\\TestOutput\\Temp",
    "Logs": "F:\\Projetos\\Etiquetas\\TestOutput\\Logs",
    "Database": "F:\\Projetos\\Etiquetas\\TestOutput\\Data\\labelprinter.db"
  },
  "Processing": {
    "SimulationMode": false,
    "FolderPollingIntervalSeconds": 10
  },
  "Printing": {
    "Printers": [
      {
        "Name": "GenericaTermica",
        "Description": "Impressora térmica genérica (desenvolvimento)",
        "WindowsPrinterName": "",
        "DriverNamePattern": "label|thermal|pos|receipt|generic|barcode|xprinter|zebra|argox|elgin",
        "Protocol": "GhostScript",
        "Dpi": 203,
        "DefaultLabelWidthMm": 100.0,
        "DefaultLabelHeightMm": 150.0,
        "Enabled": true,
        "Priority": 10,
        "MaxRetries": 1,
        "RetryDelaySeconds": 5,
        "DefaultCopies": 1,
        "RoutingRules": []
      }
    ]
  }
}
