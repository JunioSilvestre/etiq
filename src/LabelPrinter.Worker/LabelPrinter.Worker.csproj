<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>labelprinter-worker-secrets</UserSecretsId>
    <RootNamespace>LabelPrinter.Worker</RootNamespace>
    <!-- Windows Service publishing -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabelPrinter.Core\LabelPrinter.Core.csproj" />
    <ProjectReference Include="..\LabelPrinter.Application\LabelPrinter.Application.csproj" />
    <ProjectReference Include="..\LabelPrinter.Infrastructure\LabelPrinter.Infrastructure.csproj" />
    <ProjectReference Include="..\LabelPrinter.Persistence\LabelPrinter.Persistence.csproj" />
    <ProjectReference Include="..\LabelPrinter.Printing\LabelPrinter.Printing.csproj" />
    <ProjectReference Include="..\LabelPrinter.Documents\LabelPrinter.Documents.csproj" />
    <ProjectReference Include="..\LabelPrinter.Labels\LabelPrinter.Labels.csproj" />
    <ProjectReference Include="..\LabelPrinter.Diagnostics\LabelPrinter.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>


</Project>
