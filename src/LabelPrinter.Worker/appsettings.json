{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{ThreadId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/labelprinter-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] [{ThreadId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithMachineName"
    ]
  },
  "Paths": {
    "Downloads": "",
    "Processing": "Processing",
    "Archive": "Archive",
    "Failed": "Failed",
    "Pdf": "PDFs",
    "Temp": "Temp",
    "Logs": "Logs",
    "Database": "Data"
  },
  "Processing": {
    "MaxConcurrentJobs": 4,
    "MaxConcurrentRendering": 2,
    "MaxRetries": 3,
    "RetryDelaySeconds": 30,
    "ProcessingTimeoutSeconds": 120,
    "FolderPollingIntervalSeconds": 1,
    "AcceptedExtensions": [
      ".zip",
      ".7z",
      ".tar",
      ".gz",
      ".txt",
      ".csv",
      ".pdf",
      ".zpl",
      ".epl"
    ],
    "RetentionDays": 90,
    "SimulationMode": false
  },
  "Security": {
    "MaxArchiveSizeBytes": 524288000,
    "MaxExtractedSizeBytes": 1073741824,
    "MaxFilesInArchive": 1000,
    "MaxLabelCount": 500,
    "MaxTextLength": 10000,
    "AllowedExtractedExtensions": [
      ".txt",
      ".csv",
      ".pdf",
      ".zpl",
      ".epl",
      ".json",
      ".xml"
    ]
  },
  "FileStability": {
    "CheckCount": 2,
    "CheckIntervalMs": 500,
    "TimeoutSeconds": 60,
    "MinFileSizeBytes": 10
  },
  "Labels": {
    "Standard100x150": {
      "Name": "Standard100x150",
      "WidthMm": 100.0,
      "HeightMm": 150.0,
      "MarginMm": 3.0,
      "DefaultDpi": 203,
      "MinQrCodeSizeMm": 20.0,
      "MinBarcodeSizeMm": 40.0
    },
    "Small50x30": {
      "Name": "Small50x30",
      "WidthMm": 50.0,
      "HeightMm": 30.0,
      "MarginMm": 1.5,
      "DefaultDpi": 203,
      "MinQrCodeSizeMm": 10.0,
      "MinBarcodeSizeMm": 20.0
    }
  },
  "Printing": {
    "SumatraPdfPath": "C:\\Users\\Administrator\\AppData\\Local\\SumatraPDF\\SumatraPDF.exe",
    "GhostScriptPath": "C:\\Program Files\\gs\\gs10.03.1\\bin\\gswin64c.exe",
    "PrintTimeoutSeconds": 60,
    "MaxConcurrentPrintingPerPrinter": 1,
    "Printers": [
      {
        "Name": "GenericaTermica",
        "Description": "Impressora térmica genérica detectada automaticamente",
        "WindowsPrinterName": "",
        "DriverNamePattern": "label|thermal|pos|receipt|generic|barcode|xprinter|zebra|argox|elgin",
        "Protocol": "GhostScript",
        "Dpi": 203,
        "DefaultLabelWidthMm": 100.0,
        "DefaultLabelHeightMm": 150.0,
        "Enabled": true,
        "Priority": 10,
        "MaxRetries": 3,
        "RetryDelaySeconds": 30,
        "DefaultCopies": 1,
        "RoutingRules": [
          {
            "Marketplace": null,
            "LabelSize": null,
            "Priority": 100
          }
        ]
      }
    ]
  },
  "Service": {
    "ServiceName": "LabelPrinterService",
    "DisplayName": "LabelPrinter - Impressão Automática de Etiquetas",
    "Description": "Monitora a pasta Downloads e imprime automaticamente etiquetas térmicas.",
    "GracefulShutdownTimeoutSeconds": 30
  }
}
